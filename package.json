{
    "main": "dist/runCommand.js",
    "dependencies": {
        "@google-cloud/firestore": "^8.3.0",
        "@hono/node-server": "^1.19.12",
        "@types/lodash": "^4.14.123",
        "@types/minimist": "^1.2.0",
        "@types/moment-timezone": "^0.5.30",
        "@types/node": "^11.13.2",
        "@types/puppeteer": "^2.0.0",
        "@types/puppeteer-core": "^2.0.0",
        "@types/shortid": "^0.0.29",
        "@types/split2": "^2.1.6",
        "better-sqlite3": "^12.8.0",
        "csv-parse": "^4.14.2",
        "drizzle-orm": "^0.45.2",
        "enquirer": "^2.3.0",
        "firebase-admin": "^9.5.0",
        "hono": "^4.12.10",
        "israeli-bank-scrapers-core": "^6.7.1",
        "lodash": "^4.17.21",
        "minimist": "^1.2.5",
        "moment": "^2.24.0",
        "moment-timezone": "^0.5.33",
        "proxy-chain": "^2.2.0",
        "puppeteer": "22.15.0",
        "shortid": "^2.2.14",
        "tsconfig-paths": "^4.1.1",
        "yn": "^3.1.0",
        "ynab": "^1.49.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "concurrently": "^9.0.1",
        "drizzle-kit": "^0.31.10",
        "nodemon": "^3.1.7",
        "prettier": "^1.16.4",
        "tsx": "^4.19.2",
        "typescript": "^5.4.5"
    },
    "scripts": {
        "build": "./node_modules/.bin/tsc --sourceMap",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "runCommand": "node --enable-source-maps dist/runCommand.js",
        "runCommand:dev": "tsx src/runCommand.ts",
        "scrape": "yarn runCommand scrape",
        "scrape:dev": "yarn runCommand:dev scrape",
        "configure": "yarn runCommand:dev configure",
        "getOtpContext": "yarn runCommand:dev getOtpContext",
        "changeids": "yarn runCommand changeIds",
        "startWeb": "yarn runCommand startWeb",
        "startWeb:dev": "yarn runCommand:dev startWeb",
        "uploadToYnab": "yarn runCommand uploadToYnab",
        "migrateFromFirestore": "GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json yarn runCommand:dev migrateFromFirestore",
        "db:generate": "npx drizzle-kit generate",
        "db:studio": "npx drizzle-kit studio"
    },
    "packageManager": "yarn@3.3.0",
    "resolutions": {
        "israeli-bank-scrapers-core/puppeteer-core": "22.15.0"
    }
}
